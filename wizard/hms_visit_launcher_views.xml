<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hms_visit_launcher_form" model="ir.ui.view">
        <field name="name">hms.visit.launcher.form</field>
        <field name="model">hms.visit.launcher</field>
        <field name="arch" type="xml">
            <form string="Register Visit">
                <group>
                    <field name="patient_id" readonly="1"/>
                    <field name="visit_type_id"
                           options="{'no_create': True, 'no_open': True}"/>
                </group>
                <footer>
                    <button name="action_launch" string="Open Visit"
                            type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
