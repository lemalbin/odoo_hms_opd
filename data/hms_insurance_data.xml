            <field name="scheme_type">chf</field>
            <field name="claims_method">District Council Portal</field>
            <field name="avg_settlement_days">45</field>
            <field name="pre_auth_required">False</field>
        </record>

        <record id="scheme_jubilee" model="hms.insurance.scheme">
            <field name="name">Jubilee Insurance</field>
