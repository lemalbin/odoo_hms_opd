            <field name="avg_settlement_days">21</field>
            <field name="pre_auth_required">True</field>
            <field name="pre_auth_threshold">200000</field>
        </record>

        <record id="scheme_alliance" model="hms.insurance.scheme">
            <field name="name">Alliance Insurance</field>
            <field name="scheme_type">private</field>
            <field name="claims_method">Email / Portal</field>
            <field name="avg_settlement_days">30</field>
            <field name="pre_auth_required">True</field>
            <field name="pre_auth_threshold">300000</field>
        </record>

