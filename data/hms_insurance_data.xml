<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Tanzania Insurance Schemes -->
        <record id="scheme_nhif" model="hms.insurance.scheme">
            <field name="name">NHIF — National Health Insurance Fund</field>
            <field name="scheme_type">nhif</field>
            <field name="claims_method">NHIF eClaims Portal</field>
            <field name="avg_settlement_days">30</field>
            <field name="pre_auth_required">True</field>
            <field name="pre_auth_threshold">500000</field>
        </record>

        <record id="scheme_chf" model="hms.insurance.scheme">
