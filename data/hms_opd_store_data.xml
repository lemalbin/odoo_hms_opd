<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- OPD consumables store location -->
        <record id="location_opd_store" model="stock.location">
            <field name="name">OPD Store</field>
            <field name="usage">internal</field>
            <field name="location_id" ref="stock.stock_location_locations"/>
        </record>

        <!-- Product category for OPD consumables -->
        <record id="prod_categ_opd_consumables" model="product.category">
            <field name="name">OPD Consumables</field>
        </record>

        <!-- Consolidated department-requisition sequence (OPD/IPD/RCH share it) -->
        <record id="seq_hms_dept_requisition" model="ir.sequence">
            <field name="name">Department Requisition</field>
            <field name="code">hms.dept.requisition</field>
            <field name="prefix">REQ-%(year)s-</field>
            <field name="padding">5</field>
        </record>

        <!-- NOTE: consumables are created at runtime (their storable product is
             built then, with the full registry available) - not seeded here. -->

    </data>
</odoo>
