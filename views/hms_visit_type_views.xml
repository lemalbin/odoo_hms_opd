<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hms_visit_type_list" model="ir.ui.view">
        <field name="name">hms.visit.type.list</field>
        <field name="model">hms.visit.type</field>
        <field name="arch" type="xml">
            <list string="Visit Types" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="res_model"/>
                <field name="icon"/>
                <field name="note"/>
                <field name="is_available"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_hms_visit_type_form" model="ir.ui.view">
        <field name="name">hms.visit.type.form</field>
        <field name="model">hms.visit.type</field>
        <field name="arch" type="xml">
            <form string="Visit Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="res_model"/>
                        <field name="icon"/>
                        <field name="sequence"/>
                        <field name="note"/>
                        <field name="is_available"/>
                        <field name="active"/>
                    </group>
                    <p class="text-muted">
                        Point each visit type at a department's model (e.g. hms.opd.visit,
                        hms.dental.visit). Types whose module is not installed show
                        Installed = false and are hidden from the patient launcher.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_hms_visit_type" model="ir.actions.act_window">
        <field name="name">Visit Types</field>
        <field name="res_model">hms.visit.type</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hms_config_visit_types"
              name="Visit Types"
              parent="menu_hms_config"
              action="action_hms_visit_type"
              sequence="40"/>

</odoo>
