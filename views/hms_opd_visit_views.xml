<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ═══════════════════════════════════════════════════════════
         OPD Visit — Form View
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_hms_opd_visit_form" model="ir.ui.view">
        <field name="name">hms.opd.visit.form</field>
        <field name="model">hms.opd.visit</field>
        <field name="arch" type="xml">
            <form string="OPD Visit">
                <header>
<button name="action_open_triage" string="Open Triage Form" type="object"
                            class="btn-primary" invisible="state != 'triage'"/>
                    <button name="action_to_waiting" string="Add to Queue" type="object"
                            class="btn-primary" invisible="state != 'triage'"/>
                    <button name="action_start_consultation" string="Start Consultation" type="object"
                            class="btn-primary" invisible="state != 'waiting'"/>
                    <button name="action_awaiting_investigation" string="Awaiting Results" type="object"
                            class="btn-secondary" invisible="state != 'consultation'"/>
                    <button name="action_ready_discharge" string="Ready for Discharge" type="object"
                            class="btn-secondary" invisible="state not in ['consultation', 'investigation']"/>
                    <button name="action_complete" string="Complete Visit" type="object"
                            class="btn-success" invisible="state != 'discharge'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                            class="btn-danger" invisible="state in ['completed', 'cancelled']"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="registration,triage,waiting,consultation,discharge,completed"/>
                </header>

                <div class="alert alert-danger" role="alert" invisible="not has_allergies">
                    <strong>⚠ ALLERGY ALERT</strong> — Patient has recorded allergies. Check before prescribing.
                </div>

                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_triage_history" type="object"
                                class="oe_stat_button" icon="fa-heartbeat">
                            <field name="triage_count" widget="statinfo" string="Triage"/>
                        </button>
                        <button name="%(action_hms_queue)d" type="action"
                                class="oe_stat_button" icon="fa-list-ol"
                                invisible="not queue_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_value"><field name="queue_number"/></span>
                                <span class="o_stat_text">Queue No.</span>
                            </div>
                        </button>
                        <button name="action_view_procedures" type="object"
                                class="oe_stat_button" icon="fa-syringe"
                                invisible="procedure_count == 0">
                            <field name="procedure_count" widget="statinfo" string="Procedures"/>
                        </button>
                    </div>

                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Patient">
                            <field name="patient_id"
                                   readonly="state not in ('registration', 'triage')"/>
                            <field name="patient_age_display" readonly="1" string="Age"/>
                            <field name="patient_gender" readonly="1"/>
                            <field name="patient_blood_group" readonly="1"/>
                            <field name="patient_nhif_number" readonly="1"
                                   invisible="payer_type not in ('nhif', 'insurance')"/>
                            <field name="has_allergies" invisible="1"/>
                            <field name="is_paediatric" invisible="1"/>
                        </group>
                        <group string="Visit Details">
                            <field name="visit_date"/>
                            <field name="visit_type"/>
                            <field name="department"/>
                            <field name="attending_doctor_id" readonly="1"/>
                            <field name="payer_type"/>
                            <field name="insurance_scheme_id"
                                   invisible="payer_type != 'insurance'"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Vital Signs" name="vitals">
                            <group>
                                <group string="Cardiovascular">
                                    <field name="triage_bp_systolic"/>
                                    <field name="triage_bp_diastolic"/>
                                    <field name="triage_bp_display"/>
                                    <field name="triage_pulse"/>
                                </group>
                                <group string="Respiratory &amp; Temp">
                                    <field name="triage_temperature"/>
                                    <field name="triage_respiratory_rate"/>
                                    <field name="triage_spo2"/>
                                </group>
                                <group string="Anthropometry">
                                    <field name="triage_weight"/>
                                    <field name="triage_height"/>
                                    <field name="triage_bmi"/>
                                </group>
                                <group string="Other">
                                    <field name="triage_rbs"/>
                                    <field name="triage_gcs"/>
                                    <field name="triage_pain_scale"/>
                                </group>
                            </group>
                            <p class="text-muted" style="padding: 0 16px;">
                                Vitals are captured via the Triage button above; this shows the latest triage reading.
                            </p>
                        </page>

                        <page string="Consultation" name="consultation">
                            <field name="consultation_ids"
                                   context="{'default_visit_id': id}">
                                <list editable="bottom">
                                    <field name="consultation_product_id"/>
                                    <field name="clinician_id"
                                           domain="[('is_clinical_staff', '=', True)]"
                                           optional="hide"/>
                                    <field name="unit_price"/>
                                    <field name="chargeable" widget="boolean_toggle" optional="hide"/>
                                    <field name="consultation_date" optional="hide"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                            <p class="text-muted" style="padding: 0 16px;">
                                Add a consultation line to raise its charge on the patient's bill.
                                A visit may have more than one (e.g. general then specialist).
                                Leave empty for a procedure-only visit.
                            </p>
                        </page>

                        <page string="Clinical Notes" name="clinical">
                            <group>
                                <field name="chief_complaint" placeholder="Main reason for today's visit..."/>
                                <field name="pain_scale"/>
                            </group>
                            <group string="History of Presenting Illness">
                                <field name="history" nolabel="1" widget="html"/>
                            </group>
                            <group string="Examination Findings">
                                <field name="examination_findings" nolabel="1"
                                       placeholder="Systematic examination findings..."/>
                            </group>
                        </page>

                        <page string="Diagnosis" name="diagnosis">
                            <group>
                                <field name="primary_diagnosis" placeholder="ICD-10 code or description"/>
                            </group>
                            <field name="diagnosis_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="diagnosis_type"/>
                                    <field name="icd10_id"
                                           options="{'no_create_edit': True}"
                                           placeholder="Search code or name..."/>
                                    <field name="icd10_code" optional="show"/>
                                    <field name="description"/>
                                    <field name="confirmed"/>
                                    <field name="notes" optional="hide"/>
                                </list>
                            </field>
                        </page>

                        <page string="Procedures" name="procedures">
                            <p class="text-muted" style="padding: 0 16px;">
                                Order procedures here, one line each. The treatment-room nurse
                                records consumables and marks them done from the Treatment Room menu.
                            </p>
                            <field name="procedure_ids"
                                   context="{'default_opd_visit_id': id}">
                                <list editable="bottom"
                                      decoration-success="state=='done'"
                                      decoration-muted="state=='cancelled'">
                                    <field name="procedure_product_id"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="chargeable" widget="boolean_toggle" optional="hide"/>
                                    <field name="performed_by_id" optional="hide"/>
                                    <field name="state" widget="badge" readonly="1"
                                           decoration-success="state=='done'"
                                           decoration-warning="state=='ordered'"
                                           decoration-danger="state=='cancelled'"/>
                                </list>
                            </field>
                        </page>

                        <page string="Management Plan" name="management">
                            <group>
                                <field name="management_plan" nolabel="1"
                                       placeholder="Treatment plan, medications, procedures ordered..."/>
                            </group>
                            <group string="Referral">
                                <field name="referral_required"/>
                                <field name="referral_to" invisible="not referral_required"/>
                            </group>
                            <group string="Admission">
                                <field name="admission_required"/>
                                <field name="ward_preference" invisible="not admission_required"/>
                            </group>
                        </page>

                        <page string="Discharge" name="discharge">
                            <group>
                                <field name="discharge_summary" nolabel="1"
                                       placeholder="Summary of management, discharge instructions..."/>
                                <field name="follow_up_date"/>
                                <field name="follow_up_notes"/>
                                <field name="discharge_time" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         OPD Visit — List View
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_hms_opd_visit_list" model="ir.ui.view">
        <field name="name">hms.opd.visit.list</field>
        <field name="model">hms.opd.visit</field>
        <field name="arch" type="xml">
            <list string="OPD Visits"
                  decoration-danger="has_allergies == True"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state == 'completed'">
                <field name="name"/>
                <field name="visit_date"/>
                <field name="patient_id"/>
                <field name="patient_age" string="Age"/>
                <field name="visit_type"/>
                <field name="department" optional="hide"/>
                <field name="triage_category"
                       decoration-danger="triage_category == 'red'"
                       decoration-warning="triage_category == 'yellow'"
                       decoration-info="triage_category == 'green'"
                       optional="show"/>
                <field name="attending_doctor_id" optional="show"/>
                <field name="queue_number" string="Q#" optional="show"/>
                <field name="payer_type" optional="show"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'completed'"
                       decoration-warning="state in ['triage','waiting']"
                       decoration-info="state == 'consultation'"
                       decoration-danger="state == 'cancelled'"/>
                <field name="has_allergies" column_invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ═══════════════════════════════════════════════════════════
         OPD Visit — Search View
    ═══════════════════════════════════════════════════════════ -->
    <record id="view_hms_opd_visit_search" model="ir.ui.view">
        <field name="name">hms.opd.visit.search</field>
        <field name="model">hms.opd.visit</field>
        <field name="arch" type="xml">
            <search string="OPD Visits">
                <field name="name" string="Visit No."/>
                <field name="patient_id"/>
                <field name="attending_doctor_id"/>
                <field name="primary_diagnosis"/>
                <filter string="Today" name="today"
                        domain="[('visit_date','&gt;=', datetime.datetime.now().strftime('%Y-%m-%d 00:00:00')),
                                  ('visit_date','&lt;=', datetime.datetime.now().strftime('%Y-%m-%d 23:59:59'))]"/>
                <filter string="Active Visits" name="active"
                        domain="[('state','not in',['completed','cancelled'])]"/>
                <filter string="Emergency" name="emergency"
                        domain="[('visit_type','=','emergency')]"/>
                <filter string="Red Triage" name="red_triage"
                        domain="[('triage_category','=','red')]"/>
                <filter string="Needing Admission" name="admission"
                        domain="[('admission_required','=',True)]"/>
                <separator/>
                <filter string="New Patients" name="new_patients"
                        domain="[('visit_type','=','new')]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Department" name="by_department" context="{'group_by': 'department'}"/>
                    <filter string="Doctor" name="by_doctor" context="{'group_by': 'attending_doctor_id'}"/>
                    <filter string="Triage" name="by_triage" context="{'group_by': 'triage_category'}"/>
                    <filter string="Status" name="by_state" context="{'group_by': 'state'}"/>
                    <filter string="Visit Date" name="by_date" context="{'group_by': 'visit_date:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hms_opd_visit" model="ir.actions.act_window">
        <field name="name">OPD Visits</field>
        <field name="res_model">hms.opd.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_opd_visit_search"/>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No OPD visits yet — register a patient to begin.</p>
        </field>
    </record>

    <record id="action_hms_opd_visit_today" model="ir.actions.act_window">
        <field name="name">Today's OPD</field>
        <field name="res_model">hms.opd.visit</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hms_opd_visit_search"/>
        <field name="context">{'search_default_today': 1, 'search_default_active': 1}</field>
    </record>

</odoo>
