<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hms_triage_form" model="ir.ui.view">
        <field name="name">hms.triage.form</field>
        <field name="model">hms.triage</field>
        <field name="arch" type="xml">
            <form string="Triage Assessment">
                <header>
                    <field name="category" widget="statusbar"
                           statusbar_visible="green,orange,yellow,red,black"/>
                </header>
                <sheet>
                    <div class="alert alert-danger text-center" role="alert" invisible="category != 'red'">
                        <h3>🔴 RED — IMMEDIATE / Life-threatening — Resuscitation NOW</h3>
                    </div>
                    <div class="alert alert-warning text-center" role="alert" invisible="category != 'yellow'">
                        <h3>🟡 YELLOW — URGENT — Seen within 30 minutes</h3>
                    </div>
                    <div class="alert alert-warning text-center" role="alert" invisible="category != 'orange'">
                        <h3>🟠 ORANGE — SEMI-URGENT — Seen within 60 minutes</h3>
                    </div>
                    <div class="alert alert-success text-center" role="alert" invisible="category != 'green'">
                        <h3>🟢 GREEN — NON-URGENT — Routine queue</h3>
                    </div>
                    <div class="alert alert-dark text-center" role="alert" invisible="category != 'black'">
                        <h3>⚫ BLACK — DEAD ON ARRIVAL — Documentation only</h3>
                    </div>

                    <group>
                        <group string="Patient &amp; Visit">
                            <field name="visit_id" readonly="1"/>
                            <field name="patient_id" readonly="1"/>
                            <field name="nurse_id"/>
                            <field name="triage_time"/>
                        </group>
                        <group string="Triage Category">
                            <field name="category" widget="radio"/>
                            <field name="expected_wait" readonly="1"/>
                            <field name="priority" readonly="1"/>
                            <field name="mode_of_arrival"/>
                        </group>
                    </group>

                    <group string="Presenting Complaint">
                        <field name="presenting_complaint" nolabel="1"
                               placeholder="Document the patient's presenting complaint..."/>
                    </group>

                    <notebook>
                        <page string="Vital Signs" name="vitals">
                            <group>
                                <group string="Cardiovascular">
                                    <field name="bp_systolic"/>
                                    <field name="bp_diastolic"/>
                                    <field name="bp_display" readonly="1" string="BP Summary"/>
                                    <field name="pulse"/>
                                </group>
                                <group string="Respiratory &amp; Temp">
                                    <field name="temperature"/>
                                    <field name="respiratory_rate"/>
                                    <field name="spo2"/>
                                </group>
                            </group>
                            <group>
                                <group string="Anthropometry">
                                    <field name="weight"/>
                                    <field name="height"/>
                                    <field name="bmi" readonly="1"/>
                                </group>
                                <group string="Other">
                                    <field name="rbs"/>
                                    <field name="gcs"/>
                                    <field name="pain_scale"/>
                                </group>
                            </group>
                        </page>

                        <page string="DOA Details" name="doa" invisible="not is_doa">
                            <field name="is_doa" invisible="1"/>
                            <group>
                                <field name="doa_certifying_doctor"/>
                                <field name="police_notified"/>
                                <field name="police_ob_number" invisible="not police_notified"/>
                            </group>
                        </page>

                        <page string="Notes" name="notes">
                            <field name="notes" nolabel="1" placeholder="Additional triage observations..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_hms_triage_list" model="ir.ui.view">
        <field name="name">hms.triage.list</field>
        <field name="model">hms.triage</field>
        <field name="arch" type="xml">
            <list string="Triage Records"
                  decoration-danger="category == 'red'"
                  decoration-warning="category in ['yellow','orange']"
                  decoration-success="category == 'green'"
                  decoration-muted="category == 'black'">
                <field name="triage_time"/>
                <field name="patient_id"/>
                <field name="category"
                       decoration-danger="category == 'red'"
                       decoration-warning="category in ['yellow','orange']"
                       decoration-success="category == 'green'"/>
                <field name="expected_wait" readonly="1"/>
                <field name="presenting_complaint"/>
                <field name="bp_display" string="BP" readonly="1"/>
                <field name="pulse"/>
                <field name="spo2"/>
                <field name="temperature"/>
                <field name="nurse_id"/>
            </list>
        </field>
    </record>

    <record id="action_hms_triage" model="ir.actions.act_window">
        <field name="name">Triage</field>
        <field name="res_model">hms.triage</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
