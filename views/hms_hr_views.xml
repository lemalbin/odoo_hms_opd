<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add 'Clinical Staff' flag to the employee form under the HR tab -->
    <record id="view_hr_employee_form_hms_ext" model="ir.ui.view">
        <field name="name">hr.employee.form.hms</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_id']" position="after">
                <field name="is_clinical_staff"/>
            </xpath>
        </field>
    </record>

</odoo>
